#!/bin/bash
# New-Mac setup. Secrets (~/.ssh, ~/.zshrc.local, ~/.config) are copied separately, never via git.
set -e

command -v brew >/dev/null || /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
eval "$(/opt/homebrew/bin/brew shellenv)"

[ -d "$HOME/.oh-my-zsh" ] || RUNZSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"

brew bundle --file="$HOME/.dotfiles/Brewfile"

for f in .zshrc .vimrc .vim .global-gitignore; do
  ln -sfn "$HOME/.dotfiles/shell/$f" "$HOME/$f"
done
ln -sfn "$HOME/.dotfiles/macos/.mackup.cfg" "$HOME/.mackup.cfg"
git config --global core.excludesfile "$HOME/.global-gitignore"

echo "Done. Next: sign in to Dropbox, then run 'mackup restore'."
