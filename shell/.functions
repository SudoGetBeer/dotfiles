# Run tests
function p() {
   local php_bin="$(herd which-php)"
   if [ -f vendor/bin/pest ]; then
      local args=("$php_bin" vendor/bin/pest)
      [[ "$("$php_bin" vendor/bin/pest --version 2>/dev/null)" =~ ([0-9]+)\.[0-9]+\.[0-9]+ ]] && (( ${match[1]:-0} >= 5 )) && { args+=(--tia); echo "Using --tia (Test Impact Analysis)"; }
      "${args[@]}" "$@"
   else
      "$php_bin" vendor/bin/phpunit "$@"
   fi
}

function pf() {
   if [ -f vendor/bin/pest ]; then
      vendor/bin/pest --filter "$@"
   else
      vendor/bin/phpunit --filter "$@"
   fi
}

arm() {
  arch -x86_64 $@
}


pullDM() {
    ( set -e
    git checkout develop
    git pull
    git checkout -

    masterBranch="master"
    if [ `git rev-parse --verify --quiet main` ]
    then
        echo "Main branch exists"

        masterBranch="main"
    fi

    git checkout $masterBranch
    git pull
    git checkout -

    )
}

testflow() {
    myVar=$1
    if [ -z $myVar ]
    then
        myVar=$(git rev-parse --abbrev-ref HEAD)
    else
        myVar=release/$myVar
    fi

    echo $myVar
}

# git flow
gfrs() {
    ( set -e
    git fetch
    gc develop
    git pull --rebase
    #gc -b release/$1
    gh pr create --fill --title $1
    gh pr view --web
    )
}
